<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+) backup / device-transfer rules. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="photos/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="photos/" />
    </device-transfer>
</data-extraction-rules>
